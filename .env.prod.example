# Production Settings
DEBUG=False
SECRET_KEY=change-this-in-production-to-a-secure-random-string
ALLOWED_HOSTS=localhost,127.0.0.1,api.nessfood.com

# Database
DATABASE_URL=postgres://postgres:postgres@db:5432/nessfood

# Stripe (Live keys)
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Frontend
FRONTEND_URL=https://nessfood.com
CORS_ALLOWED_ORIGINS=https://nessfood.com

# Email (SMTP)
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=apikey
EMAIL_HOST_PASSWORD=your-sendgrid-api-key
DEFAULT_FROM_EMAIL=Ness Food <noreply@nessfood.com>
